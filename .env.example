# Examples only. Set actual secrets in your terminal or Render dashboard.
ADMIN_EMAIL=staff@your-domain.example
ADMIN_PASSWORD=replace-with-a-unique-long-password
# Local development defaults to a persistent H2 file; no database server is required.
# Production on Render with Neon Free PostgreSQL:
# SPRING_PROFILES_ACTIVE=production
# DB_HOST=your-neon-host.neon.tech
# DB_PORT=5432
# DB_NAME=neondb
# DB_USERNAME=your-neon-role
# DB_PASSWORD=set-only-in-render
# DB_POOL_SIZE=3
# COOKIE_SECURE=true

# Optional local frontend address reference; the API uses same-origin paths.
APP_BASE_URL=http://localhost:5173
